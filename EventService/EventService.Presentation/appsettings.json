{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=EventServiceDb;Username=postgres;Password=postgres"
  },
  "JwtSettings": {
    "Secret": "your-super-secret-key-min-32-chars-long",
    "Issuer": "UserService",
    "Audience": "EventManagerServiceClients",
    "ExpirationMinutes": 60
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "GroupId": "event-service-group",
    "SessionTimeoutMs": 30000,
    "HeartbeatIntervalMs": 10000
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "EventTtlSeconds": 300,
    "TopEventsTtlSeconds": 60,
    "EventKeyPrefix": "event:",
    "TopEventsKey": "events:top10"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Confluent.Kafka": "Warning"
    }
  },
  "Otlp": {
    "Endpoint": "http://localhost:4317"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
